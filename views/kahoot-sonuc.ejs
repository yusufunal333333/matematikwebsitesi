<%- include('partials/header') %>

<h1 class="sayfa-baslik">⚡ Kahoot Sonuçları</h1>

<% if (kaydedildi && kaydedilenSonuc) { %>
  <div class="icerik-kutusu" style="border-left: 4px solid #16a34a; background: #f0fdf4; margin-bottom: 1.5rem;">
    <strong>✓ Sonuç kaydedildi:</strong> <%= kaydedilenSonuc.ad %> <%= kaydedilenSonuc.soyad %> - <%= kaydedilenSonuc.dogru %>/<%= kaydedilenSonuc.toplam %>
  </div>
<% } %>

<div class="quiz-layout">
  <div class="quiz-sol">
    <div class="sonuc-ozet" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem; border-radius: 12px; margin-bottom: 2rem;">
      <h2 style="margin-top: 0; color: white;">🏆 Puanınız</h2>
      <div style="font-size: 3.5rem; font-weight: bold; margin: 1rem 0;"><%= dogru %> / <%= toplam %></div>
      <p style="font-size: 1.1rem; margin: 0;">
        <% if (dogru >= 13) { %>
          🎉 Harika! Çok iyi bir skor!
        <% } else if (dogru >= 9) { %>
          👍 İyi! Biraz daha çalış...
        <% } else { %>
          💪 Devam et! Başarı için çalış!
        <% } %>
      </p>
    </div>

    <!-- Sonuç Kaydetme Formu -->
    <% if (!kaydedildi) { %>
    <div class="kaydet-formu" style="background: #f9fafb; padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem;">
      <h3>📝 Sonucunuzu Liderboardu'na Kaydedin</h3>
      <form method="POST" action="/kahoot-kaydet">
        <input type="hidden" name="dogru" value="<%= dogru %>">
        <input type="hidden" name="toplam" value="<%= toplam %>">
        <div class="kaydet-alanlar">
          <input type="text" name="ad" placeholder="Adınız" required maxlength="50" class="kaydet-input" style="padding: 0.75rem; margin-bottom: 0.75rem; border: 2px solid #ddd; border-radius: 6px;">
          <input type="text" name="soyad" placeholder="Soyadınız" required maxlength="50" class="kaydet-input" style="padding: 0.75rem; margin-bottom: 0.75rem; border: 2px solid #ddd; border-radius: 6px;">
          <button type="submit" class="kaydet-btn" style="background: #16a34a; color: white; padding: 0.75rem 2rem; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; width: 100%;">📤 Koru & Kaydet</button>
        </div>
      </form>
    </div>
    <% } %>

    <h3 style="margin-top: 2rem; margin-bottom: 1rem;">📊 Cevaplarımız</h3>
    <% sonuclar.forEach(function(s, i) { %>
      <div class="soru-sonuc <%= s.dogruMu ? 'dogru' : 'yanlis' %>" style="margin-bottom: 1.5rem; padding: 1rem; border-left: 4px solid <%= s.dogruMu ? '#16a34a' : '#dc2626' %>; background: <%= s.dogruMu ? '#f0fdf4' : '#fef2f2' %>;">
        <span class="sonuc-etiket <%= s.dogruMu ? 'dogru' : 'yanlis' %>" style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 6px; margin-bottom: 0.5rem; font-weight: bold; background: <%= s.dogruMu ? '#16a34a' : '#dc2626' %>; color: white;"><%= s.dogruMu ? '✓ Doğru' : '✗ Yanlış' %></span>
        <h4 style="margin: 0.5rem 0;"><%= i + 1 %>. <%= s.soru %></h4>
        <p style="margin: 0.25rem 0;"><strong>Doğru cevap:</strong> <span style="color: #16a34a; font-weight: bold;"><%= s.secenekler[s.dogruIndex] %></span></p>
        <% if (!s.dogruMu && !isNaN(s.kullaniciIndex) && s.kullaniciIndex >= 0) { %>
          <p style="margin: 0.25rem 0;"><strong>Sizin cevabınız:</strong> <span style="color: #dc2626; font-weight: bold;"><%= s.secenekler[s.kullaniciIndex] %></span></p>
        <% } %>
      </div>
    <% }); %>

    <div style="text-align: center; margin: 2rem 0;">
      <a href="/kahoot" style="display:inline-block; background:#2563eb; color:#fff; padding:0.75rem 2rem; border-radius:8px; font-weight:bold; text-decoration: none; margin-right: 1rem;">Tekrar Dene ⚡</a>
      <a href="/" style="display:inline-block; background:#6c757d; color:#fff; padding:0.75rem 2rem; border-radius:8px; font-weight:bold; text-decoration: none;">Ana Sayfa 🏠</a>
    </div>
  </div>

  <div class="quiz-sag">
    <div class="liderlik-tablosu">
      <h3>🏆 Kahoot Liderlik (Top 10)</h3>
      <% if (liderlik.length === 0) { %>
        <p class="liderlik-bos">Henüz kimse Kahoot'u tamamlamadı. İlk sen ol!</p>
      <% } else { %>
        <ol class="liderlik-listesi">
          <% liderlik.forEach(function(k, i) { %>
            <li class="liderlik-satir <%= i === 0 ? 'lider-altin' : i === 1 ? 'lider-gumus' : i === 2 ? 'lider-bronz' : '' %>" style="padding: 0.75rem; margin-bottom: 0.5rem; background: <%= i === 0 ? '#fef3c7' : i === 1 ? '#f3f4f6' : i === 2 ? '#fed7aa' : 'white' %>; border-radius: 6px; display: flex; justify-content: space-between; align-items: center;">
              <span class="lider-sira" style="font-weight: bold; width: 30px;"><%= i + 1 %>.</span>
              <span class="lider-isim" style="flex: 1;"><%= k.ad %> <%= k.soyad %></span>
              <span class="lider-puan" style="font-weight: bold; background: #2563eb; color: white; padding: 0.25rem 0.75rem; border-radius: 4px;"><%= k.dogru %>/<%= k.toplam %></span>
            </li>
          <% }); %>
        </ol>
      <% } %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
<script>
  // Konfeti animasyonu başlat
  function konfetiYagdir() {
    const duration = 3000; // 3 saniye
    const animationEnd = Date.now() + duration;
    
    function seeDot() {
      const timeLeft = animationEnd - Date.now();
      if (timeLeft <= 0) return;
      
      confetti({
        particleCount: 100,
        spread: 70,
        origin: { x: Math.random(), y: Math.random() - 0.2 }
      });
      
      requestAnimationFrame(seeDot);
    }
    
    seeDot();
  }
  
  // Sayfa yüklendiğinde konfeti başlat
  window.addEventListener('load', function() {
    setTimeout(konfetiYagdir, 500); // 0.5 saniye gecikme
  });
  
  // Veya hemen başlat
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setTimeout(konfetiYagdir, 500);
  }
</script>

<%- include('partials/footer') %>
