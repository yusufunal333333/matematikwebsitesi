<%- include('partials/header') %>

<h1 class="sayfa-baslik">Quiz Sonuçları</h1>

<% if (kaydedildi && kaydedilenSonuc) { %>
  <div class="icerik-kutusu" style="border-left: 4px solid #16a34a; background: #f0fdf4; margin-bottom: 1.5rem;">
    <strong>Sonuç kaydedildi:</strong> <%= kaydedilenSonuc.ad %> <%= kaydedilenSonuc.soyad %> - <%= kaydedilenSonuc.dogru %>/<%= kaydedilenSonuc.toplam %>
  </div>
<% } %>

<div class="quiz-layout">
  <div class="quiz-sol">
    <div class="sonuc-ozet">
      <h2>Puanınız</h2>
      <div class="puan"><%= dogru %> / <%= toplam %></div>
      <p><%= dogru >= 20 ? 'Harika! Matematik bilginiz çok güçlü!' : dogru >= 13 ? 'İyi bir sonuç! Biraz daha çalışarak daha iyisini yapabilirsiniz.' : 'Daha çok çalışmanız gerekiyor. Konuları tekrar gözden geçirin!' %></p>
    </div>

    <!-- Sonuç Kaydetme Formu -->
    <div class="kaydet-formu">
      <h3>📝 Sonucunuzu Kaydedin</h3>
      <form method="POST" action="/quiz-kaydet">
        <input type="hidden" name="dogru" value="<%= dogru %>">
        <input type="hidden" name="toplam" value="<%= toplam %>">
        <div class="kaydet-alanlar">
          <input type="text" name="ad" placeholder="Adınız" required maxlength="50" class="kaydet-input">
          <input type="text" name="soyad" placeholder="Soyadınız" required maxlength="50" class="kaydet-input">
          <button type="submit" class="kaydet-btn">Kaydet</button>
        </div>
      </form>
    </div>

    <% sonuclar.forEach(function(s, i) { %>
      <div class="soru-sonuc <%= s.dogruMu ? 'dogru' : 'yanlis' %>">
        <span class="sonuc-etiket <%= s.dogruMu ? 'dogru' : 'yanlis' %>"><%= s.dogruMu ? 'Doğru' : 'Yanlış' %></span>
        <h4><%= i + 1 %>. <%= s.soru %></h4>
        <p>Doğru cevap: <strong><%= s.secenekler[s.dogruIndex] %></strong></p>
        <% if (!s.dogruMu && !isNaN(s.kullaniciIndex) && s.kullaniciIndex >= 0) { %>
          <p>Sizin cevabınız: <%= s.secenekler[s.kullaniciIndex] %></p>
        <% } %>
      </div>
    <% }); %>

    <div style="text-align: center; margin: 2rem 0;">
      <a href="/quiz" style="display:inline-block; background:#2563eb; color:#fff; padding:0.75rem 2rem; border-radius:8px; font-weight:bold;">Tekrar Dene</a>
    </div>
  </div>

  <div class="quiz-sag">
    <div class="liderlik-tablosu">
      <h3>🏆 En İyi 10</h3>
      <% if (liderlik.length === 0) { %>
        <p class="liderlik-bos">Henüz kimse quiz'i tamamlamadı. İlk sen ol!</p>
      <% } else { %>
        <ol class="liderlik-listesi">
          <% liderlik.forEach(function(k, i) { %>
            <li class="liderlik-satir <%= i === 0 ? 'lider-altin' : i === 1 ? 'lider-gumus' : i === 2 ? 'lider-bronz' : '' %>">
              <span class="lider-sira"><%= i + 1 %>.</span>
              <span class="lider-isim"><%= k.ad %> <%= k.soyad %></span>
              <span class="lider-puan"><%= k.dogru %>/<%= k.toplam %></span>
            </li>
          <% }); %>
        </ol>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
<script>
  // Konfeti animasyonu başlat
  function konfetiYagdir() {
    const duration = 3000; // 3 saniye
    const animationEnd = Date.now() + duration;
    
    function seeDot() {
      const timeLeft = animationEnd - Date.now();
      if (timeLeft <= 0) return;
      
      confetti({
        particleCount: 100,
        spread: 70,
        origin: { x: Math.random(), y: Math.random() - 0.2 }
      });
      
      requestAnimationFrame(seeDot);
    }
    
    seeDot();
  }
  
  // Sayfa yüklendiğinde konfeti başlat
  window.addEventListener('load', function() {
    setTimeout(konfetiYagdir, 500); // 0.5 saniye gecikme
  });
  
  // Veya hemen başlat
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setTimeout(konfetiYagdir, 500);
  }
</script>
