      </div>
      <div class="afis-sembol-item">
        <span class="mini-sembol">&gt;</span> Büyüktür
      </div>
      <div class="afis-sembol-item">
        <span class="mini-sembol">√</span> Karekök
      </div>
      <div class="afis-sembol-item">
        <span class="mini-sembol">π</span> Pi (3,14...)
      </div>
      <div class="afis-sembol-item">
        <span class="mini-sembol">∞</span> Sonsuz
